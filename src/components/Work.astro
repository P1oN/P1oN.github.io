---
import { work } from "../data/content";
---

<section id="work" aria-labelledby="work-title">
  <div class="section-top">
    <p class="eyebrow">01 / SELECTED WORK</p><a href="/cv/"
      >Full experience <span aria-hidden="true">↗</span></a>
  </div>
  <h2 id="work-title">Built for real-world complexity.</h2>
  <div class="work-grid">
    {
      work.map((item) => (
        <article class="work-card">
          <div class="card-meta">
            <>
              <span>{item.company}</span>
              <span>{item.period}</span>
            </>
          </div>
          <div class="work-number" aria-hidden="true">
            {item.number}
            <span> /</span>
          </div>
          <>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <p class="stack">{item.tags}</p>
          </>
        </article>
      ))
    }
  </div>
</section>

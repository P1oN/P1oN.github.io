---
import "../styles/global.css";
import Work from "../components/Work.astro";
import Projects from "../components/Projects.astro";
import { currentCompany, previousCompanies } from "../data/content";
const description =
  "Boryslav Mytrofanov — senior frontend-first software engineer building reliable web applications with React, Next.js, and TypeScript.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Boryslav Mytrofanov — Senior Software Engineer</title><meta
      name="description"
      content={description}
    />
    <meta name="color-scheme" content="light dark" /><link
      rel="canonical"
      href="https://p1on.github.io/"
    />
    <meta property="og:type" content="website" /><meta
      property="og:title"
      content="Boryslav Mytrofanov — Software Engineer"
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content="https://p1on.github.io/"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='10' fill='%230b6b62'/%3E%3Ctext x='10' y='29' font-family='sans-serif' font-size='28' fill='white'%3EP%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("p1on-theme");
        } catch {}
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="P1oN home"
          >P1oN<span>.</span></a
        ><nav aria-label="Main navigation">
          <a href="#work">Work</a><a href="#projects">Projects</a><a href="/cv/"
            >CV</a
          ><a href="#contact">Contact</a>
        </nav><button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          ><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
            ><circle
              cx="12"
              cy="12"
              r="8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></circle><path
              d="M12 4a8 8 0 0 1 0 16z"
              fill="currentColor"></path></svg
          ></button
        >
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <p class="identity">
            Boryslav Mytrofanov <span>/</span>
            <span>Senior Software Engineer · Frontend-first</span>
          </p><h1 id="hero-title">
            Thoughtful interfaces.<br /><span>Reliable web applications.</span>
          </h1><p class="intro">
            I build production web applications with React, Next.js, and
            TypeScript, focusing on architecture, performance, and
            maintainability.
          </p><div class="hero-actions">
            <a class="button" href="#work"
              >View selected work <span aria-hidden="true">↗</span></a
            ><a class="text-link" href="/cv/"
              >Read CV <span aria-hidden="true">↗</span></a
            >
          </div><p class="current-company">
            Currently at <strong
              ><a
                href={currentCompany.linkedin}
                aria-label={`${currentCompany.name} on LinkedIn`}
                >{currentCompany.name}</a
              ></strong
            >
          </p><p class="previously">
            Previously at {
              previousCompanies.map((company, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <a
                    href={company.linkedin}
                    aria-label={`${company.name} on LinkedIn`}
                  >
                    {company.name}
                  </a>
                </>
              ))
            }
          </p>
        </section>
        <Work /><Projects />
        <section class="approach" aria-labelledby="approach-title">
          <div>
            <p class="eyebrow">03 / HOW I WORK</p><h2 id="approach-title">
              Care for the details.<br />Keep the system clear.
            </h2>
          </div><div class="approach-copy">
            <p>
              I care about maintainable architecture, fast interfaces, and clear
              ownership. I work across frontend and backend boundaries to turn
              complex requirements into reliable products.
            </p><p>
              I enjoy sharing what I learn, mentoring developers, and helping
              teams deliver thoughtfully.
            </p>
          </div>
        </section>
        <section class="contact" id="contact" aria-labelledby="contact-title">
          <div class="contact-symbol" aria-hidden="true">↗</div><div>
            <h2 id="contact-title">Have a product worth building?</h2><p>
              Let’s talk.
            </p><a href="mailto:borispion@gmail.com"
              >borispion@gmail.com <span aria-hidden="true">↗</span></a
            >
          </div>
        </section>
      </main>
      <footer>
        <div>
          <span>Boryslav Mytrofanov</span><p class="footnote">
            Static by design. Under 14 KB gzip.
          </p>
        </div><div class="footer-links">
          <a href="https://github.com/P1oN">GitHub ↗</a><a
            href="https://linkedin.com/in/borislav-m">LinkedIn ↗</a
          ><a href="/cv/">CV ↗</a>
        </div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement,
          button = document.querySelector(".theme-toggle"),
          system = matchMedia("(prefers-color-scheme: dark)");
        const dark = () =>
          root.dataset.theme ? root.dataset.theme === "dark" : system.matches;
        const update = () =>
          button.setAttribute(
            "aria-label",
            "Switch to " + (dark() ? "light" : "dark") + " theme",
          );
        update();
        system.addEventListener("change", update);
        button.addEventListener("click", () => {
          const theme = dark() ? "light" : "dark";
          root.dataset.theme = theme;
          try {
            localStorage.setItem("p1on-theme", theme);
          } catch {}
          update();
        });
      })();
    </script>
  </body>
</html>
